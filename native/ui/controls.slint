import { Theme, Icon } from "theme.slint";

export component FIcon inherits Text {
    in property <string> glyph;
    text: glyph;
    font-family: Theme.icons;
    font-size: 16px;
    color: Theme.text;
    vertical-alignment: center;
    horizontal-alignment: center;
}

export component Label inherits Text {
    font-family: Theme.font;
    font-size: Theme.body;
    color: Theme.text;
    vertical-alignment: center;
    overflow: elide;
}

// Fluent standard / accent button with optional leading icon.
export component FButton inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <bool> accent;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked;

    property <color> fg: !enabled ? Theme.text-3 : accent ? Theme.on-accent : danger ? Theme.critical : Theme.text;
    height: 32px;
    min-width: 32px;
    border-radius: Theme.radius-sm;
    border-width: accent ? 0 : 1px;
    border-color: Theme.stroke-strong;
    background: accent
        ? (!enabled ? Theme.stroke-strong : ta.pressed ? Theme.accent.with-alpha(0.8) : ta.has-hover ? Theme.accent-hover : Theme.accent)
        : (ta.pressed ? Theme.subtle-pressed : ta.has-hover ? Theme.card-hover : Theme.card);
    animate background { duration: 90ms; }
    accessible-role: button;
    accessible-label: text;

    HorizontalLayout {
        padding-left: text == "" ? 8px : 12px;
        padding-right: text == "" ? 8px : 12px;
        spacing: 8px;
        alignment: center;
        if glyph != "": FIcon {
            glyph: glyph;
            font-size: 14px;
            color: fg;
        }
        if text != "": Label {
            text: text;
            color: fg;
            font-weight: accent ? 600 : 400;
            overflow: clip;
        }
    }

    ta := TouchArea {
        enabled: enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Borderless icon button (title bars, row actions).
export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <length> size: 32px;
    in property <color> tint: Theme.text-2;
    in property <string> tooltip;
    callback clicked;
    out property <bool> hovered: ta.has-hover;
    width: size;
    height: size;
    border-radius: Theme.radius-sm;
    background: ta.pressed ? Theme.subtle-pressed : ta.has-hover ? Theme.subtle-hover : transparent;
    accessible-role: button;
    accessible-label: tooltip;
    FIcon {
        glyph: glyph;
        font-size: 14px;
        color: tint;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// NavigationView item with the Win11 accent pill on the selected row.
export component NavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> text;
    in property <string> trailing;
    in property <bool> selected;
    in property <bool> collapsed;
    in property <bool> show-dot;
    in property <color> dot-color;
    callback clicked;

    height: 36px;
    border-radius: Theme.radius-sm;
    background: selected ? Theme.subtle-hover : ta.pressed ? Theme.subtle-pressed : ta.has-hover ? Theme.subtle-hover : transparent;
    animate background { duration: 90ms; }
    accessible-role: button;
    accessible-label: text;

    Rectangle {
        x: 0;
        width: 3px;
        height: selected ? 16px : 0;
        border-radius: 1.5px;
        background: Theme.accent;
        animate height { duration: 160ms; easing: ease-out; }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 14px;
        FIcon {
            glyph: glyph;
            width: 16px;
            color: Theme.text;
        }
        if !collapsed: Label {
            text: text;
            horizontal-stretch: 1;
        }
        if !collapsed && trailing != "": Label {
            text: trailing;
            color: Theme.text-3;
            font-size: Theme.caption;
        }
        if show-dot: Rectangle {
            width: 8px;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: dot-color;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.stroke;
}

export component Pill inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    height: 20px;
    border-radius: 10px;
    background: Theme.status-bg(kind);
    min-width: lbl.preferred-width + 16px;
    lbl := Label {
        text: text;
        font-size: 11px;
        font-weight: 600;
        color: Theme.status-fg(kind);
        horizontal-alignment: center;
    }
}

// Fluent ProgressBar: 1px rail with a 3px rounded indicator.
export component ProgressBar inherits Rectangle {
    in property <int> value;
    in property <color> tint: Theme.accent;
    height: 3px;
    Rectangle {
        height: 1px;
        background: Theme.stroke-strong;
    }
    Rectangle {
        x: 0;
        width: parent.width * clamp(value, 0, 100) / 100;
        height: 3px;
        border-radius: 1.5px;
        background: tint;
        animate width { duration: 400ms; easing: ease-out; }
    }
}

export component KpiTile inherits Card {
    in property <string> label;
    in property <string> value;
    in property <string> glyph;
    in property <int> kind;
    in property <int> bar: -1;
    height: 92px;
    VerticalLayout {
        padding: 16px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            FIcon {
                glyph: glyph;
                font-size: 14px;
                width: 16px;
                color: kind == 0 ? Theme.accent : Theme.status-fg(kind);
            }
            Label {
                text: label;
                font-size: Theme.caption;
                color: Theme.text-2;
            }
        }
        Label {
            text: value;
            font-family: Theme.font-display;
            font-size: 28px;
            font-weight: 600;
            color: Theme.text;
        }
        if bar >= 0: ProgressBar {
            value: bar;
        }
    }
}

component SegOption inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    border-radius: 3px;
    background: active ? Theme.accent : ta.has-hover ? Theme.subtle-hover : transparent;
    min-width: l.preferred-width + 20px;
    l := Label {
        text: root.text;
        font-size: Theme.caption;
        horizontal-alignment: center;
        color: active ? Theme.on-accent : Theme.text;
        font-weight: active ? 600 : 400;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Two-or-more option segmented control.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> index;
    callback selected(int);
    height: 32px;
    border-radius: Theme.radius-sm;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.stroke-strong;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for opt[i] in options: SegOption {
            text: opt;
            active: i == root.index;
            clicked => { root.selected(i); }
        }
    }
}

// Fluent InfoBar. kind: 1 success, 2 info, 3 caution, 4 critical.
export component InfoBar inherits Rectangle {
    in property <int> kind: 2;
    in property <string> text;
    in property <bool> closable: true;
    callback closed;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.stroke;
    background: Theme.status-bg(kind);
    min-height: 48px;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 6px;
        spacing: 12px;
        FIcon {
            width: 16px;
            glyph: kind == 1 ? Icon.check : kind == 4 ? Icon.error : kind == 3 ? Icon.warning : Icon.info;
            color: Theme.status-fg(kind);
        }
        Label {
            text: text;
            wrap: word-wrap;
            overflow: clip;
            horizontal-stretch: 1;
        }
        if closable: IconButton {
            y: (parent.height - self.height) / 2;
            glyph: Icon.close;
            tooltip: "Close";
            clicked => { root.closed(); }
        }
    }
}

// Fluent ContentDialog: smoke layer + centered card with a tinted footer.
export component ContentDialog inherits Rectangle {
    in property <string> title;
    in property <string> primary-text: "Save";
    in property <string> secondary-text: "Cancel";
    in property <bool> danger;
    in property <string> error;
    in property <length> dialog-width: 460px;
    callback accepted;
    callback canceled;

    background: Theme.smoke;
    // Swallow clicks so the page underneath stays inert.
    TouchArea { }
    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { root.canceled(); return accept; }
            reject
        }
    }

    Rectangle {
        width: dialog-width;
        height: body.preferred-height;
        background: Theme.layer;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.stroke-strong;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000040;
        clip: true;

        body := VerticalLayout {
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Label {
                    text: title;
                    font-family: Theme.font-display;
                    font-size: Theme.subtitle;
                    font-weight: 600;
                }
                if error != "": InfoBar {
                    kind: 4;
                    text: error;
                    closable: false;
                }
                @children
            }
            Rectangle {
                height: 80px;
                background: Theme.mica;
                border-width: 0;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.stroke;
                }
                HorizontalLayout {
                    padding: 24px;
                    spacing: 8px;
                    FButton {
                        horizontal-stretch: 1;
                        text: primary-text;
                        accent: !danger;
                        danger: danger;
                        clicked => { root.accepted(); }
                    }
                    FButton {
                        horizontal-stretch: 1;
                        text: secondary-text;
                        clicked => { root.canceled(); }
                    }
                }
            }
        }
    }
}

export component FieldLabel inherits Label {
    font-size: Theme.caption;
    color: Theme.text-2;
}
